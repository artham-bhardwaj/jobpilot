# JobPilot settings for the Docker container. Copy to .env.docker (git-ignored), fill in, and keep it private:
#   cp .env.docker.example .env.docker && chmod 600 .env.docker
# Placeholders only. Paths, host and port are fixed by compose.yaml (data in /data), so don't set them here.

JOBPILOT_LOG_LEVEL=INFO

# Local time for the daily summary hour and for "today" in summaries (containers default to UTC).
TZ=Asia/Kolkata

# Internal scheduler (one per deployment). Enable tasks under Settings -> scheduler in the dashboard.
JOBPILOT_SCHEDULER_ENABLED=true
JOBPILOT_SCHEDULER_POLL_SECONDS=300

# Polite job collection
JOBPILOT_HTTP_TIMEOUT_SECONDS=20
JOBPILOT_HTTP_MAX_RETRIES=2
JOBPILOT_HTTP_MIN_INTERVAL_SECONDS=2.0
JOBPILOT_RESPECT_ROBOTS_TXT=true
JOBPILOT_USER_AGENT=JobPilot/0.1 (personal job-search assistant)

# Browser-assisted applications need Chrome, which this image does not contain.
JOBPILOT_BROWSER_ENABLED=false

# Gmail (optional). Put the OAuth client JSON and token in /data/secrets (see docs/DOCKER.md); the interactive
# `jobpilot gmail auth` cannot run inside the container.
JOBPILOT_GMAIL_ENABLED=false
JOBPILOT_GMAIL_ALLOW_READ_BODIES=false

# Telegram (optional). Do NOT reuse a bot that another JobPilot (e.g. the native one) is polling at the same time.
JOBPILOT_TELEGRAM_ENABLED=false
JOBPILOT_TELEGRAM_BOT_TOKEN=
JOBPILOT_TELEGRAM_CHAT_ID=
JOBPILOT_TELEGRAM_COMMANDS_ENABLED=true
