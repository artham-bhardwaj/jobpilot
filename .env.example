# JobPilot configuration. Copy to .env and adjust. Every value is optional.
# .env is git-ignored; never commit real credentials.
# JobPilot reads ./.env from the current directory. To use a file elsewhere, set the
# environment variable JOBPILOT_ENV_FILE=/path/to/file (it must exist).
# Relative paths below resolve against the current directory.

# --- Core ---------------------------------------------------------------
# Directory for the database, resumes, logs, backups, tokens, browser profile.
JOBPILOT_DATA_DIR=./data
# Leave empty to use sqlite:///<DATA_DIR>/jobpilot.db
JOBPILOT_DATABASE_URL=
JOBPILOT_LOG_LEVEL=INFO

# --- Web server ---------------------------------------------------------
# Bound to localhost by default. Binding elsewhere also requires
# JOBPILOT_ALLOW_REMOTE_BIND=true (not recommended: there is no login).
JOBPILOT_HOST=127.0.0.1
JOBPILOT_PORT=8765
JOBPILOT_ALLOW_REMOTE_BIND=false
# Serve the JSON API schema at /openapi.json (no Swagger UI is served). Off by default.
JOBPILOT_ENABLE_OPENAPI=false

# --- Job collection (HTTP politeness) -----------------------------------
JOBPILOT_HTTP_TIMEOUT_SECONDS=20
JOBPILOT_HTTP_MAX_RETRIES=2
# Minimum seconds between requests to the same host.
JOBPILOT_HTTP_MIN_INTERVAL_SECONDS=2.0
JOBPILOT_RESPECT_ROBOTS_TXT=true
# Identify yourself honestly; add a contact address if you like.
JOBPILOT_USER_AGENT=JobPilot/0.1 (personal job-search assistant)

# --- Optional: scheduler ------------------------------------------------
# When true, `jobpilot serve` also runs due tasks in a background thread.
# Alternatively use the systemd user timer in deploy/ (see README).
JOBPILOT_SCHEDULER_ENABLED=false
JOBPILOT_SCHEDULER_POLL_SECONDS=300

# --- Optional: browser-assisted applications (Playwright) ---------------
# Requires: pip install -e ".[browser]"  (uses your installed Google Chrome)
JOBPILOT_BROWSER_ENABLED=false
JOBPILOT_BROWSER_CHANNEL=chrome
JOBPILOT_BROWSER_HEADLESS=false

# --- Optional: Gmail integration (see docs/GMAIL_SETUP.md) --------------
JOBPILOT_GMAIL_ENABLED=false
# Path to the OAuth client JSON downloaded from Google Cloud Console.
JOBPILOT_GMAIL_CLIENT_SECRETS_PATH=./data/secrets/gmail_client_secret.json
# Grant read access to message bodies (needed only to import interview
# invitations from Gmail). Default: metadata only.
JOBPILOT_GMAIL_ALLOW_READ_BODIES=false

# --- Optional: Telegram notifications and read-only commands (see docs/TELEGRAM.md)
JOBPILOT_TELEGRAM_ENABLED=false
# From @BotFather. Secret: never commit it, never paste it into issues or logs.
JOBPILOT_TELEGRAM_BOT_TOKEN=
# Your chat id, set explicitly with `jobpilot telegram find-chat` then `jobpilot telegram set-chat <id>`.
JOBPILOT_TELEGRAM_CHAT_ID=
# Answer /status, /jobs ... from your chat while `jobpilot serve` runs.
JOBPILOT_TELEGRAM_COMMANDS_ENABLED=true
